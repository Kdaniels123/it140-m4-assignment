# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    DISPLAY "Welcome to the higher/lower
game, Bella!"

     DO
        PROMPT "Enter the lower bound: "
        INPUT lowerBound
        PROMPT "Enter the upper bound: "
        INPUT upperBound

        IF lowerBound >= upperBound THEN
            DISPLAY "The lower bound must be
less than the upper bound."
         ENDIF
    WHILE lowerBound >= upperBound

    # Establish the number the player is trying to guess.
    SET secretNumber = RANDOM INTEGER between 
lowerBound and upperBound inclusive

    # Play the game.
    DO
        PROMPT "Great, now guess a number
between " + lowerBound + " and " + upperBound
+ ": "
         INPUT guess

        IF guess < lowerBound OR guess >
upperBound THEN
            DISPLAY "Please enter a number
between " + lowerBound + " and " + upperBound
+ "."
         ENDIF
     WHILE guess < lowerBound OR guess 
> upperBound

   WHILE guess not equal secretNumber
        IF guess < secretNumber THEN
            DISPLAY "Nope, too low."
        ELSE
            DISPLAY "Nope, too high."
        ENDIF

        DO
            PROMPT "Guess another number: "
            INPUT guess

            IF guess < lowerBound OR guess >
upperBound THEN
                 DISPLAY "Please enter a number 
between " + lowerBound + " and " + upperBound
+ "."
           ENDIF
       WHILE guess < lowerBound OR guess 
> upperBound
    ENDWHILE

    DISPLAY "You got it!"

END hilow_game

